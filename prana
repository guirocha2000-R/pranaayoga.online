<script>
(function(){
  var orb=document.getElementById('orb'), word=document.getElementById('breathWord'),
      btn=document.getElementById('breathBtn'), hint=document.getElementById('breathHint');
  var timer=null, running=false, endAt=0;
  var phases=[{t:'Inspire',d:4000,c:'in'},{t:'Segure',d:4000,c:'hold'},{t:'Expire',d:6000,c:''}];
  function stop(msg){
    running=false; clearTimeout(timer); orb.className='orb'; orb.style.transitionDuration='';
    word.textContent=msg||'Respire comigo'; btn.textContent='Iniciar 1 minuto de respiração';
    hint.textContent='Ciclo 4 · 4 · 6 — inspire, segure, expire';
  }
  function run(i){
    if(!running) return;
    if(Date.now()>=endAt){ stop('Sinta a sua força'); return; }
    var p=phases[i%3];
    orb.style.transitionDuration=(p.d/1000)+'s';
    orb.className='orb '+p.c;
    word.textContent=p.t;
    var left=Math.max(0,Math.ceil((endAt-Date.now())/1000));
    hint.textContent=left+' s restantes';
    timer=setTimeout(function(){run(i+1)},p.d);
  }
  btn.addEventListener('click',function(){
    if(running){ stop(); return; }
    running=true; endAt=Date.now()+56000; btn.textContent='Parar'; run(0);
  });

  var modal=document.getElementById('modal'), mt=document.getElementById('modalTitle'),
      mx=document.getElementById('modalText'), ok=document.getElementById('modalOk');
  document.querySelectorAll('[data-plan]').forEach(function(b){
    b.addEventListener('click',function(){
      mt.textContent=b.dataset.plan+' · R$ '+b.dataset.price+' / mês';
      mx.textContent='A sua primeira aula é experimental e gratuita. Depois dela, o plano começa a contar.';
      ok.hidden=false;
      modal.hidden=false; ok.focus();
    });
  });
  function close(){ modal.hidden=true; }
  document.getElementById('modalClose').addEventListener('click',close);
  modal.addEventListener('click',function(e){ if(e.target===modal) close(); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  ok.addEventListener('click',function(){
    mx.textContent='Pedido registado. A equipa do estúdio entra em contacto para marcar o dia da sua aula experimental.';
    ok.hidden=true;
  });

  var form=document.getElementById('newsForm'), msg=document.getElementById('newsMsg'), em=document.getElementById('email');
  form.addEventListener('submit',function(e){
    e.preventDefault();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em.value.trim())){
      msg.textContent='Escreva um e-mail válido, por exemplo nome@email.com.'; em.focus(); return;
    }
    msg.textContent='Inscrição feita. A primeira carta chega na próxima segunda-feira.';
    form.reset();
  });
})();
</script>

